# SQLite file, relative to the project root.
DATABASE_URL="file:./dev.db"

# Master key for encrypting the API key saved in the app (32 random bytes, base64).
# Generate with: npm run gen:secret   Without it, keys can only come from ANTHROPIC_API_KEY.
APP_ENCRYPTION_KEY=""

# Claude API key. Optional: you can also paste a key in the app under Settings,
# which takes precedence over this one. Not needed when LLM_MODE=mock.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# live: call Claude | mock: canned response, no key needed | fail: always error (to demo the error state)
LLM_MODE="live"
